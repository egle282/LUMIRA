# ==============================================================================
# LUMIRA Environment Configuration (.env.example)
# Copy this file to .env and configure variables for your environment.
# ==============================================================================

# Application Environment (development | production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security
# In production, JWT_SECRET must be at least 32 characters long.
# Generate via: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long

# PostgreSQL Root / Superuser (Used for initialization and migrations)
DB_USER=lumira_admin
DB_PASSWORD=your_secure_db_admin_password
DB_NAME=lumira_db

# Application DB User (Unprivileged role enforcing RLS)
APP_DB_USER=lumira_app
APP_DB_PASSWORD=your_secure_app_user_password

# Admin DB User (Unprivileged role for cross-tenant admin reporting)
ADMIN_DB_USER=lumira_admin_role
ADMIN_DB_PASSWORD=your_secure_admin_role_password

# Database URLs (Direct connection format)
# Local development (default port 5433 mapped from Docker):
DATABASE_URL=postgresql+asyncpg://lumira_app:your_secure_app_user_password@localhost:5433/lumira_db
ADMIN_DATABASE_URL=postgresql+asyncpg://lumira_admin_role:your_secure_admin_role_password@localhost:5433/lumira_db
# For Docker Compose internal networking, host is 'db' on port 5432:
# DATABASE_URL=postgresql+asyncpg://lumira_app:your_secure_app_user_password@db:5432/lumira_db
# ADMIN_DATABASE_URL=postgresql+asyncpg://lumira_admin_role:your_secure_admin_role_password@db:5432/lumira_db

# Redis
REDIS_PASSWORD=your_secure_redis_password
REDIS_URL=redis://:your_secure_redis_password@localhost:6380/0

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Initial Admin Bootstrap Account (Created via create_admin.py script)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password

# AI Providers (At least one recommended for AI horoscope and briefing features)
# OpenRouter API Key (Supports free and paid models like Google Gemini Flash / Llama)
OPENROUTER_API_KEY=
# Google Gemini API Key
LLM_API_KEY=

# Telegram Bot (Optional - needed only if running backend/bot/main.py service)
TELEGRAM_BOT_TOKEN=

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

# Stripe subscriptions (optional; create recurring Prices in Stripe Dashboard)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=
FRONTEND_URL=http://localhost:5173
